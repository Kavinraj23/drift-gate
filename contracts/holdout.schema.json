{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holdout.schema.json",
  "title": "DriftGate real-log holdout: labels document (root) and run records ($defs/runs_document)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "layer": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]},
    "classification": {"enum": ["platform", "user", "transient", "governance", "unknown"]},
    "case_id": {"type": "string", "pattern": "^hc-[0-9]{2,3}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["rerun", "pr_fix", "escalate"]},
        "fix": {"type": "string", "minLength": 1, "description": "Named fix; required for pr_fix, forbidden otherwise."}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "pr_fix"}}, "required": ["kind"]}, "then": {"required": ["fix"]}, "else": {"not": {"required": ["fix"]}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "run_id", "job", "commit_sha", "url", "fetch_date"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "run_id": {"type": "integer", "minimum": 1},
        "job": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/"},
        "fetch_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "layer", "classification", "correct_action", "rationale", "source", "log_sha256", "labeled_at"],
      "properties": {
        "id": {"$ref": "#/$defs/case_id"},
        "split": {"enum": ["dev", "test"]},
        "layer": {"$ref": "#/$defs/layer"},
        "classification": {"$ref": "#/$defs/classification"},
        "correct_action": {"$ref": "#/$defs/action"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\r\n]+$"},
        "source": {"$ref": "#/$defs/source"},
        "log_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of holdout/logs/<id>.log as stored (UTF-8 bytes)."},
        "labeled_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "run_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "system", "ran_at", "label_sha256", "layer", "classification", "action"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "system": {"enum": ["agent"]},
        "ran_at": {"$ref": "#/$defs/timestamp"},
        "label_sha256": {"$ref": "#/$defs/sha256", "description": "Digest of the case's label record at run time (see eval/holdout.py label_digest); a later label edit breaks it."},
        "layer": {"$ref": "#/$defs/layer"},
        "classification": {"$ref": "#/$defs/classification"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "runs_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "runs"],
      "properties": {
        "schema_version": {"const": 1},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run_record"}}
      }
    }
  }
}
