{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holdout_candidates.schema.json",
  "title": "DriftGate holdout-fetch: candidates document (root, human-written) and fetched-record ($defs/fetched_record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "candidates": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "run_id"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$", "description": "owner/name of a PUBLIC repository."},
        "run_id": {"type": "integer", "minimum": 1},
        "job": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Exact job name. Optional when exactly one job of the run failed."}
      }
    },
    "fetched_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "case_id", "source", "job_id", "run_attempt", "step", "other_failed_steps", "log_sha256", "log_bytes"],
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"type": "string", "pattern": "^hc-[0-9]{2,3}$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "run_id", "job", "commit_sha", "url", "fetch_date"],
          "properties": {
            "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "run_id": {"type": "integer", "minimum": 1},
            "job": {"type": "string", "minLength": 1},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "url": {"type": "string", "pattern": "^https://github\\.com/"},
            "fetch_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        },
        "job_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": ["integer", "null"], "minimum": 1},
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "number"],
          "properties": {"name": {"type": "string", "minLength": 1}, "number": {"type": "integer", "minimum": 1}}
        },
        "other_failed_steps": {"type": "integer", "minimum": 0},
        "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "log_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
