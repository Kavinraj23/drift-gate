{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id", "fingerprint", "duplicate_of", "classification", "layer", "confidence",
    "blast_radius", "hypothesis", "evidence", "suspected_change", "remediation", "review",
    "prior_attempts", "abstained", "budget_truncated", "escalation_reason", "run"
  ],
  "properties": {
    "execution_id": {"type": "string"},
    "fingerprint": {"type": "string"},
    "duplicate_of": {"type": ["string", "null"]},
    "classification": {"enum": ["platform", "user", "transient", "governance", "unknown"]},
    "layer": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "blast_radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executions_affected", "shared_dimension"],
      "properties": {
        "executions_affected": {"type": "integer", "minimum": 0},
        "shared_dimension": {"type": "string"}
      }
    },
    "hypothesis": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "finding", "supports"],
        "properties": {
          "source": {"type": "string"},
          "finding": {"type": "string"},
          "supports": {"type": "string"}
        }
      }
    },
    "suspected_change": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "ref", "at", "basis"],
      "properties": {
        "kind": {"type": "string"},
        "ref": {"type": "string"},
        "at": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "remediation": {"anyOf": [{"type": "null"}, {"$ref": "remediation.schema.json"}]},
    "review": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["verdict", "comments"],
      "properties": {
        "verdict": {"enum": ["approve", "revise", "reject"]},
        "comments": {"type": "string"}
      }
    },
    "prior_attempts": {"type": "array"},
    "abstained": {"type": "boolean"},
    "budget_truncated": {"type": "boolean"},
    "escalation_reason": {"type": "string"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls", "input_tokens", "output_tokens", "cost_usd", "latency_s"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "latency_s": {"type": "number", "minimum": 0}
      }
    }
  }
}
