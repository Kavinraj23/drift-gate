{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error_catalog.schema.json",
  "type": "object",
  "required": [
    "version",
    "note",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "source",
          "box",
          "summary",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 10
          },
          "box": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
