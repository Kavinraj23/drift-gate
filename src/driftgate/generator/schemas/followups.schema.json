{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "followups.schema.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rerun": {
        "type": "object",
        "required": [
          "status",
          "log"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "log": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "fix_applied": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "status",
          "accepted_files"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "accepted_files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "rerun",
      "fix_applied"
    ]
  }
}
